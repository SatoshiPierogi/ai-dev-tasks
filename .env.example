# ============================================================================
# ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env and fill in the actual values
# ============================================================================

# ============================================================================
# APPLICATION
# ============================================================================

NODE_ENV=development
LOG_LEVEL=debug

# ============================================================================
# DATABASE
# ============================================================================

DB_HOST=postgres
DB_PORT=5432
DB_NAME=agent_audit
DB_USER=dev_user
DB_PASSWORD=dev_password
DATABASE_URL=postgresql://dev_user:dev_password@postgres:5432/agent_audit

# ============================================================================
# REDIS CACHE
# ============================================================================

REDIS_URL=redis://default:redis_password@redis:6379
REDIS_PASSWORD=redis_password

# ============================================================================
# SERVER
# ============================================================================

# Backend
BACKEND_PORT=3001
BACKEND_HOST=0.0.0.0

# Frontend
FRONTEND_PORT=3000

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================

JWT_SECRET=dev_secret_key_not_for_production_use_strong_random_string
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=7d

# ============================================================================
# BLOCKCHAIN RPC PROVIDERS
# ============================================================================

# Ethereum mainnet providers (add API keys from services)
ALCHEMY_API_KEY=your_alchemy_key_here
INFURA_API_KEY=your_infura_key_here
ANKR_API_KEY=your_ankr_key_here

# Provider configuration
RPC_PROVIDER_TIMEOUT=10000
RPC_PROVIDER_HEALTH_CHECK_INTERVAL=60000
RPC_PROVIDER_MAX_RETRIES=3

# ============================================================================
# THE GRAPH
# ============================================================================

THE_GRAPH_ENDPOINT=https://api.thegraph.com/subgraphs/name
SUBGRAPH_TIMEOUT=30000

# ============================================================================
# CACHING & STORAGE
# ============================================================================

# Cache settings
CACHE_TTL=1800000 # 30 minutes in milliseconds
CACHE_MAX_SIZE_AGENTS=1000
CACHE_MAX_SIZE_TRANSACTIONS=50000
CACHE_CLEANUP_INTERVAL=60000

# Archival settings
ARCHIVAL_RETENTION_DAYS=7
ARCHIVAL_BATCH_SIZE=1000
ARCHIVAL_SCHEDULE_INTERVAL=3600000 # 1 hour

# Storage monitoring
STORAGE_CHECK_INTERVAL=3600000 # 1 hour
STORAGE_WARNING_GB=10
STORAGE_CRITICAL_GB=20

# ============================================================================
# WEBSOCKET
# ============================================================================

WS_PORT=8080
WS_MAX_CONNECTIONS=10000
WS_HEARTBEAT_INTERVAL=30000
WS_MESSAGE_QUEUE_SIZE=1000

# ============================================================================
# FRONTEND URLs
# ============================================================================

REACT_APP_API_URL=http://localhost:3001
REACT_APP_WS_URL=ws://localhost:3001/ws
REACT_APP_LOG_LEVEL=debug

# ============================================================================
# PGADMIN (Optional - for database management UI)
# ============================================================================

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# ============================================================================
# MONITORING & METRICS
# ============================================================================

# Sentry (optional error tracking)
SENTRY_DSN=

# Analytics (optional)
ANALYTICS_TRACKING_ID=

# ============================================================================
# SECURITY
# ============================================================================

# CORS settings
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# VERIFICATION & BLOCKCHAIN
# ============================================================================

# Transaction verification
TX_CONFIRMATION_BLOCKS=12
TX_REORG_DETECTION_DEPTH=100
VERIFICATION_RETRY_MAX=5
VERIFICATION_RETRY_INTERVAL=5000

# ============================================================================
# DEPLOYMENT ENVIRONMENTS
# ============================================================================

# Staging environment
STAGING_API_URL=https://api-staging.agent-audit.dev
STAGING_WS_URL=wss://api-staging.agent-audit.dev/ws

# Production environment
PRODUCTION_API_URL=https://api.agent-audit.dev
PRODUCTION_WS_URL=wss://api.agent-audit.dev/ws
