{
  "name": "agent-audit-dashboard-frontend",
  "version": "0.1.0",
  "description": "Frontend for Agent Audit Dashboard",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src/**/*.{ts,tsx}",
    "format": "prettier --write src/**/*.{ts,tsx}"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "wagmi": "^1.4.13",
    "viem": "^1.18.9",
    "axios": "^1.5.0",
    "zustand": "^4.4.1",
    "react-router-dom": "^6.17.0",
    "recharts": "^2.10.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.31",
    "@types/react-dom": "^18.2.14",
    "@types/node": "^20.8.10",
    "@vitejs/plugin-react": "^4.2.0",
    "vite": "^5.0.2",
    "typescript": "^5.2.2",
    "vitest": "^0.34.6",
    "@vitest/ui": "^0.34.6",
    "eslint": "^8.52.0",
    "eslint-plugin-react": "^7.33.2",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "@typescript-eslint/parser": "^6.9.0",
    "prettier": "^3.0.3"
  }
}
